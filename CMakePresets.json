{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux, native",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-linux",
            "cacheVariables": { "ABR_DISK_TARGET": "linux" }
        },
        {
            "name": "windows",
            "displayName": "Windows, native",
            "binaryDir": "${sourceDir}/build-windows",
            "cacheVariables": { "ABR_DISK_TARGET": "windows" }
        },
        {
            "name": "windows-cross",
            "displayName": "Windows, cross compiled with MinGW-w64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-windows-cross",
            "cacheVariables": { "ABR_DISK_TARGET": "windows-cross" }
        }
    ],
    "buildPresets": [
        { "name": "linux", "configurePreset": "linux" },
        { "name": "windows", "configurePreset": "windows" },
        { "name": "windows-cross", "configurePreset": "windows-cross" }
    ],
    "testPresets": [
        { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
        { "name": "windows", "configurePreset": "windows", "output": { "outputOnFailure": true } }
    ]
}
